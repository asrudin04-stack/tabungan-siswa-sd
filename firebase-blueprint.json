{
  "collections": {
    "students": {
      "schema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "nis": { "type": "string" },
          "name": { "type": "string" },
          "grade": { "type": "string" },
          "parentName": { "type": "string" },
          "phone": { "type": "string" },
          "balance": { "type": "number" },
          "createdAt": { "type": "string" }
        },
        "required": ["id", "nis", "name", "grade", "balance", "createdAt"]
      }
    },
    "transactions": {
      "schema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "studentId": { "type": "string" },
          "studentName": { "type": "string" },
          "studentGrade": { "type": "string" },
          "type": { "type": "string" },
          "amount": { "type": "number" },
          "date": { "type": "string" },
          "notes": { "type": "string" },
          "recordedBy": { "type": "string" }
        },
        "required": ["id", "studentId", "studentName", "studentGrade", "type", "amount", "date", "recordedBy"]
      }
    }
  }
}
